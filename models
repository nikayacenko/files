#include <iostream>
#include <random>
#include <chrono>
#include <queue>
#include <iomanip>
#include <cmath>
#include <algorithm>

using namespace std;

int main() {
    setlocale(LC_ALL, "Ru");

    double t1 = 1.0, t2 = 7.0;
    double s1 = 1.0, s2 = 6.0;

    // Математические ожидания равномерных распределений
    double mtau = (t1 + t2) / 2.0;
    double msigma = (s1 + s2) / 2.0;

    double rho = msigma / mtau;

    cout << fixed << setprecision(6);
    cout << "Mtau = " << mtau
        << " Msigma = " << msigma << endl;
    cout << "Загрузка по средним временам: "
        << rho << endl << endl;

    mt19937 mt(static_cast<unsigned>(
        chrono::steady_clock::now().time_since_epoch().count()
        ));

    uniform_real_distribution<double> genT(t1, t2);
    uniform_real_distribution<double> genS(s1, s2);

    queue<double> q;  // Времена завершения обслуживания заявок
    double curr_t = 0.0;
    double server_t = 0.0;
    double sum_q = 0.0;
    double prev_t = 0.0;
    double total_wait = 0.0;

    const int N = 10000000;
    int waited = 0;

    for (int i = 0; i < N; ++i) {
        curr_t += genT(mt);

        // Обрабатываем завершения обслуживания до текущего прихода
        while (!q.empty() && q.front() <= curr_t) {
            double dt = q.front() - prev_t;

            // q содержит обслуживаемую заявку и ожидающие
            int waiting = max(0, static_cast<int>(q.size()) - 1);
            sum_q += waiting * dt;

            prev_t = q.front();
            q.pop();
        }

        // Учитываем длину очереди до текущего прихода
        double dt = curr_t - prev_t;
        int waiting = max(0, static_cast<int>(q.size()) - 1);
        sum_q += waiting * dt;
        prev_t = curr_t;

        double sigma = genS(mt);

        if (curr_t < server_t) {
            // Заявка вынуждена ждать
            total_wait += server_t - curr_t;
            waited++;

            server_t += sigma;
        }
        else {
            // Сервер свободен
            server_t = curr_t + sigma;
        }

        q.push(server_t);
    }

    cout << "Результаты моделирования:" << endl;
    cout << "Средняя длина очереди: "
        << sum_q / prev_t << endl;
    cout << "Среднее время ожидания: "
        << total_wait / N << endl;
    cout << "Процент ожидающих заявок: "
        << 100.0 * waited / N << "%" << endl;

    return 0;
}

